# --- Инвертор (Wi-Fi логгер) ---
# IP логгера (закрепи DHCP-резервом на роутере)
LOGGER_IP=192.168.1.50
# Серийник ЛОГГЕРА с наклейки на стике (не инвертора)
LOGGER_SN=2712345678

# --- Telegram ---
TG_TOKEN=123456789:AAF-your-token
TG_CHAT_ID=123456789

# --- Батарея ---
BATTERY_KWH=5.12
# Как Shutdown SOC в инверторе
MIN_SOC=20
# Пороги SOC для уведомлений во время отключения
SOC_ALERTS=50,30,20
# 1 — если в --test заряд показывается положительным числом
BATT_INVERT=0

# --- График ЯСНО ---
# Черга с yasno.ua (пусто — без графика)
YASNO_GROUP=3.1
# Регион: по умолчанию Киев. Для Днепра и др. — свой URL planned-outages с app.yasno.ua
#YASNO_URL=https://app.yasno.ua/api/blackout-service/public/shutdowns/regions/25/dsos/902/planned-outages
# Запас меньше этого (мин) — «Впритык»
CHARGE_MARGIN_MIN=15

# --- Оформление ---
SHOW_TIMELINE=1
SHOW_DETAILS=1
EFFECTS=1

# --- Тонкая настройка (можно не трогать) ---
POLL_SEC=10
GRID_V_MIN=170
CONFIRM=3
TZ_NAME=Europe/Kyiv

# --- Сторож и ошибки ---
# Ping URL внешнего сторожа (например, healthchecks.io); пусто — выключено
HEARTBEAT_URL=
# Ошибки, о которых не сообщать (F13 — смена режима при пропадании сети)
FAULT_IGNORE=F13

# --- Нагрузка ---
# Мощность инвертора и порог «Большая нагрузка» при работе от батареи, Вт
INVERTER_W=5000
OVERLOAD_W=4000
# Вводной автомат квартиры, А: «из N А» в сумме заряд + бойлер + квартира (пусто — не показывать)
MAIN_BREAKER_A=25

# --- Тариф, грн/кВт·ч (ночь с NIGHT_FROM до NIGHT_TO) ---
TARIFF_DAY=4.32
TARIFF_NIGHT=2.16
NIGHT_FROM=23
NIGHT_TO=7

# --- Калибровка: «пора калибровать» в «Батарея», если 100% не было дольше N дней ---
CALIB_DAYS=14

# --- Бойлер на розетке Tuya (пусто — выключено) ---
# id розетки из devices.json (его создаёт tuya_login.py или python -m tinytuya wizard)
BOILER_ID=
# IP розетки (пусто — искать в сети) и версия протокола из python -m tinytuya scan
BOILER_IP=
BOILER_VERSION=3.3
# Поле мощности розетки (0,1 Вт): обычно 19, у T34-Smart Plug+ — 22
BOILER_POWER_DP=19

# --- Климат (/climate): датчики Tuya, которые не показывать, через запятую ---
# Имена с пробелами — в кавычках: CLIMATE_HIDE="Серверная, Гараж"
CLIMATE_HIDE=
# Пороги «влажно» / «сухо», %
HUM_HIGH=65
HUM_LOW=30
